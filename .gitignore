.zcompdump
.env
mpv/watch_later/
qt5ct.conf
obsidian/workspace.json

# pi agent: deny-by-default, allowlist real config so new runtime/cache
# files pi invents (auth.json, sessions/, trust.json, models-store.json,
# npm/, git/, logs/, mcp-*-cache.json, mcp-onboarding.json, ...) are
# ignored automatically without editing this file.
pi/*
!pi/AGENTS.md
!pi/SYSTEM.md
!pi/settings.json
!pi/keybindings.json
!pi/mcp.json
!pi/models.json
!pi/agents/
!pi/agents/**
!pi/extensions/
!pi/extensions/**
!pi/prompts/
!pi/prompts/**
!pi/skills/
!pi/skills/**
!pi/themes/
!pi/themes/**

.pi/*

# must follow the re-includes above (gitignore is last-match-wins)
pi/extensions/**/logs/
pi/extensions/**/node_modules/
# ...except the hand-written test stubs for @earendil-works packages that pi's
# own loader resolves at runtime but plain `node --test` cannot (see
# pi/extensions/subagent/marker-extension.test.ts header comment).
!pi/extensions/node_modules/
!pi/extensions/node_modules/@earendil-works/
!pi/extensions/node_modules/@earendil-works/pi-tui/

ralph.log

# suckless build artifacts (build via README instructions, don't commit)
dmenu/dmenu
dmenu/stest
dmenu/*.o
slock/slock
slock/*.o
