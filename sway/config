# Sway config — ported from the previous awesome setup. Palette: gruvbox-dark.

set $mod     Mod4
set $alt     Mod1
set $term    ghostty
set $browser brave-origin
set $scripts $HOME/.config/sway/scripts

# ─── Autostart ────────────────────────────────────────────────────────────────
exec_always dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP
exec_always systemctl --user import-environment WAYLAND_DISPLAY SWAYSOCK && systemctl --user restart hyprvoice
exec swaybg -m fill -i "$(find $HOME/gitprojects/wallpapers -maxdepth 1 -name '*.jpg' | shuf -n1)"
exec nm-applet --indicator
exec blueman-applet
exec copyq
exec mako
exec waybar

# ─── Look & feel ──────────────────────────────────────────────────────────────
default_border none
gaps inner 6
gaps outer 8
font pango:NotoSans Nerd Font 10

client.focused          #FE8019 #FE8019 #1D2021 #FE8019
client.focused_inactive #1A1B26 #1A1B26 #D4BE98 #1A1B26
client.unfocused        #1A1B26 #1A1B26 #D4BE98 #1A1B26
client.urgent           #9D0006 #9D0006 #D4BE98 #9D0006

# swayfx effects (needs the swayfx build, see sway/swayfx-build)
blur enable
blur_passes 2
blur_radius 5
blur_noise 0.02
blur_brightness 0.9
blur_xray disable

corner_radius 8
smart_corner_radius enable

default_dim_inactive 0.25
dim_inactive_colors.unfocused #000000FF

scratchpad_minimize enable

layer_effects "waybar" blur enable; blur_ignore_transparent enable; corner_radius 10
layer_effects "notifications" blur enable; blur_ignore_transparent enable; corner_radius 10

for_window [all] opacity 0.85
for_window [app_id="mpv"] opacity 1, blur disable, dim_inactive 0
for_window [class="mpv"] opacity 1

seat seat0 xcursor_theme Bibata-Modern-Classic 20
focus_follows_mouse no
focus_on_window_activation smart

# ─── Input ────────────────────────────────────────────────────────────────────
input type:keyboard {
    xkb_layout "us"
}

input type:touchpad {
    natural_scroll enabled
    tap enabled
    drag enabled
    drag_lock disabled
    click_method button_areas
    scroll_factor 1.0
    accel_profile adaptive
    pointer_accel 0.1
    dwt enabled
}

input type:pointer {
    accel_profile flat
    pointer_accel 0
    scroll_factor 2
}

# ─── Keybindings ──────────────────────────────────────────────────────────────
floating_modifier $mod normal

# Launch
bindsym $mod+Return exec $term
bindsym $mod+e exec pcmanfm
bindsym $mod+b exec $browser --profile-directory='Profile 2'
bindsym $mod+Shift+b exec $browser --profile-directory='Profile 1'
# Float + pin focused window to all workspaces (e.g. Google Meet PiP video)
bindsym $mod+Shift+o floating enable, sticky toggle
bindsym $mod+r exec $scripts/menu.sh -r
bindsym $mod+p exec copyq toggle
bindsym $mod+d exec hyprvoice toggle
bindsym $mod+Shift+d exec hyprvoice cancel
bindsym $mod+s exec grim -g "$(slurp)" - | wl-copy -t image/png && notify-send Screenshot 'Copied to clipboard'
bindsym $mod+Shift+s exec $scripts/recording.sh

# System
bindsym $mod+BackSpace exec makoctl dismiss --all
bindsym $mod+Shift+r reload
bindsym $mod+x exec pkill -SIGUSR1 waybar
bindsym $mod+Shift+BackSpace exec swaylock -f -c 1d2021
bindsym $mod+Shift+q exec swaynag -t warning -m 'Exit sway?' -B 'Yes' 'swaymsg exit'

# Focus
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Tab focus next
bindsym $mod+Shift+Tab focus prev
bindsym $mod+u [urgent=latest] focus

# Layout
bindsym $mod+w layout tabbed
bindsym $mod+Shift+w layout toggle split
bindsym $mod+v splitv
bindsym $mod+g splith

# Move
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# Window actions
bindsym $mod+f fullscreen toggle
bindsym $mod+m fullscreen toggle
bindsym $mod+q kill
bindsym $mod+o floating toggle
bindsym $mod+t sticky toggle
bindsym $mod+n move scratchpad
bindsym $mod+Shift+n scratchpad show

# Resize (tiled)
bindsym $mod+Left resize shrink width 50px
bindsym $mod+Down resize grow height 50px
bindsym $mod+Up resize shrink height 50px
bindsym $mod+Right resize grow width 50px

# Move floating windows
bindsym $alt+Left move left 50px
bindsym $alt+Down move down 50px
bindsym $alt+Up move up 50px
bindsym $alt+Right move right 50px

# Brightness and audio
bindsym XF86MonBrightnessUp exec brightnessctl set +5%
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-
bindsym XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle

# Workspaces
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9

# ─── Window rules ─────────────────────────────────────────────────────────────
# Floating rules. Native Wayland: app_id/title. window_role/window_type/class: XWayland only.
# Per-rule `move position center` (no global center rule: it would undo PiP/sharing-bar positions).

## Generic
for_window [window_role="(?i)^(pop-up|bubble|dialog|task_dialog|preferences|about)$"] floating enable
for_window [window_type="menu"] floating enable
for_window [app_id="^pinentry"] floating enable, move position center
for_window [class="(?i)^pinentry"] floating enable, move position center
for_window [app_id="(?i)^(zenity|yad)$"] floating enable, move position center
for_window [title="^((Open|Save|Select|Choose) (File|Files|Folder|As|Image)|File Upload)$"] floating enable, resize set 900 600, move position center
for_window [app_id="^xdg-desktop-portal-gtk$"] floating enable, resize set 900 600, move position center

## Browsers: PiP + screen-share bars (Chrome/Brave/Firefox)
for_window [title="(?i)^Picture[ -]in[ -]Picture$"] floating enable, sticky enable, resize set 480 270, move position 75 ppt 70 ppt
for_window [title="^.+ is sharing (your screen|a window|a \w+ tab)( and audio)?\.$"] floating enable, sticky enable, border none, move position 35 ppt 94 ppt
for_window [title="^(Firefox|Firefox Developer Edition|Firefox Nightly|LibreWolf) (—|-) Sharing Indicator$"] floating enable, sticky enable, border none
for_window [app_id="^(org\.mozilla\.)?firefox$" title="^(Library|About Mozilla Firefox)$"] floating enable, resize set 900 600, move position center
for_window [app_id="^(org\.mozilla\.)?firefox$" title="^Extension: "] floating enable, resize set 480 700, move position center
for_window [title="^Bitwarden$"] floating enable, resize set 480 700, move position center

## Utilities
for_window [app_id="pcmanfm"] floating enable, resize set 800 600, move position center
for_window [app_id="^((org\.pulseaudio\.)?pavucontrol|com\.saivert\.pwvucontrol)$"] floating enable, resize set 900 600, move position center
for_window [app_id=".*blueman-manager.*"] floating enable, resize set 700 500, move position center
for_window [app_id="^(nm-connection-editor|nm-openconnect-auth-dialog|system-config-printer|galculator|org\.gnome\.Calculator|gnome-calculator|qalculate-gtk|nwg-look|transmission-gtk|blueberry\.py|file-roller|org\.gnome\.FileRoller|wdisplays|solaar|nl\.hjdskes\.gcolor3)$"] floating enable, move position center
for_window [app_id="^(polkit-gnome-authentication-agent-1|hyprpolkitagent|org\.kde\.polkit-kde-authentication-agent-1|xfce-polkit|lxpolkit)$"] floating enable, move position center
for_window [class="(?i)^(lxappearance|feh)$"] floating enable, move position center
for_window [app_id="^(com\.github\.hluk\.)?copyq$"] floating enable, sticky enable, resize set 700 500, move position cursor
for_window [app_id="^[Tt]hunar$" title="^(File Operation Progress|Confirm to replace files)$"] floating enable, border none, move position center

## Password managers (dialogs only)
for_window [app_id="^org\.keepassxc\.KeePassXC$" title="^(Generate Password|KeePassXC - Browser Access Request)$"] floating enable, move position center

## Calls / chat
for_window [class="^zoom$"] floating enable, move position center
for_window [class="^zoom$" title="^(Zoom Meeting|Meeting|Zoom Webinar|Zoom Workplace.*|Zoom - (Free|Licensed) [Aa]ccount)$"] floating disable
for_window [app_id="^Zoom Workplace$" title="^(zoom|Zoom|About)$"] floating enable, move position center
for_window [title="^(zoom_linux_float_video_window|as_toolbar)$"] floating enable, sticky enable, border none
for_window [title="^Microsoft Teams Notification$"] floating enable, sticky enable
no_focus [title="^Microsoft Teams Notification$"]
for_window [title="^Slack \| mini panel$"] floating enable, sticky enable
for_window [app_id="^discord$" title="^Discord Updater$"] floating enable, border none, move position center
no_focus [app_id="^discord$" title="^Discord Updater$"]

## Steam / JetBrains / misc
for_window [class="^steam$" title="^(?!Steam$|Steam Big Picture Mode$).+"] floating enable, move position center
for_window [class="^jetbrains-" title="^win0$"] floating enable, border none, move position center
for_window [app_id="^jetbrains-" title="^win0$"] floating enable, border none, move position center
for_window [app_id="^jetbrains-\w+$" title="^(?i)welcome\sto\s\w+$"] floating enable, move position center
for_window [app_id="^jetbrains-toolbox$"] floating enable, border none
for_window [app_id="^soffice$" title="^Open$"] floating enable, move position center
for_window [title="^GIMP Startup$"] floating enable, border none, move position center

assign [app_id="obsidian"] workspace number 4
assign [app_id="slack"] workspace number 7
