{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "gruvbox"
  },
  "keybinds": {
    "terminal.suspend": "none",
    "app.exit": "ctrl+c"
  },
  "attention": {
    "enabled": true,
    "sound": true,
    "volume": 0.8
  },
  "scroll": {
    "acceleration": true
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "show",
    "markdown": "rendered"
  },
  "animations": true,
  "tabs": {
    "enabled": true,
    "layout": "horizontal"
  }
}
