{
  "$schema": "https://opencode.ai/config.json",
  "update": "auto",
  "default_agent": "plan",
  "experimental": {
    "subagent_depth": 4,
  },
  "providers": {
    "opencode": {
      "headers": {
        "sleeve-provider": "opencode",
        "sleeve-harness": "opencode",
      },
      "settings": {
        "baseURL": "http://127.0.0.1:17321",
      },
    },
    "anthropic": {
      "headers": {
        "sleeve-provider": "anthropic",
        "sleeve-harness": "opencode",
      },
      "settings": {
        "baseURL": "http://127.0.0.1:17321",
      },
    },
    "copilot": {
      "headers": { "sleev-provider": "copilot", "sleev-harness": "opencode" },
      "settings": {
        "baseURL": "http://127.0.0.1:17321",
      },
    },
  },
  "model": "anthropic/claude-sonnet-5",
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*.env", "effect": "deny" },
    { "action": "edit", "resource": "*.env.defaults", "effect": "ask" },
    { "action": "edit", "resource": "*.env.example", "effect": "ask" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.defaults", "effect": "allow" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "rm *", "effect": "ask" },
    { "action": "shell", "resource": "rmdir *", "effect": "ask" },
    { "action": "shell", "resource": "* .env *", "effect": "ask" },
    { "action": "shell", "resource": "git restore *", "effect": "deny" },
    { "action": "shell", "resource": "git stash *", "effect": "ask" },
    { "action": "shell", "resource": "git clean *", "effect": "ask" },
    { "action": "shell", "resource": "HUSKY=0 git *", "effect": "ask" },
    { "action": "shell", "resource": "git commit *", "effect": "ask" },
    { "action": "shell", "resource": "git reset *", "effect": "ask" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "git -C *", "effect": "deny" },
    { "action": "shell", "resource": "docker compose down *", "effect": "ask" },
    { "action": "shell", "resource": "docker volume rm *", "effect": "ask" },
    { "action": "subagent", "resource": "code-reviewer", "effect": "deny" },
    { "action": "skill", "resource": "commit-checklist", "effect": "deny" },
    { "action": "skill", "resource": "understand", "effect": "deny" },
    { "action": "skill", "resource": "understand-*", "effect": "deny" },
  ],
  "formatter": false,
  "share": "disabled",
  "agents": {
    "compaction": {
      "model": "github-copilot/gpt-5.6-luna#high",
      "request": { "body": { "temperature": 0.4 } },
    },
    "title": {
      "model": "github-copilot/gpt-5.4-mini",
    },
    "build": {
      "color": "#d3869b",
      "permissions": [
        {
          "action": "subagent",
          "resource": "code-reviewer",
          "effect": "allow",
        },
        {
          "action": "skill",
          "resource": "commit-checklist",
          "effect": "allow",
        },
      ],
    },
    "plan": {
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        {
          "action": "subagent",
          "resource": "code-reviewer",
          "effect": "allow",
        },
      ],
      "color": "#8ec07c",
    },
    "explore": {
      "model": "anthropic/claude-haiku-4-5",
      "color": "#b8bb26",
    },
    "general": { "model": "anthropic/claude-sonnet-5", "color": "#b8bb26" },
  },
  "plugins": ["file:/home/sahil.jassal/personal/opencode-anthropic-auth"],
  "compaction": { "auto": false },
  "mcp": {
    "servers": {
      "exa": {
        "type": "local",
        "command": ["npx", "-y", "exa-mcp-server"],
        "environment": { "EXA_API_KEY": "{env:EXA_API_KEY}" },
        "disabled": true,
      },
      "ref": {
        "type": "remote",
        "url": "https://api.ref.tools/mcp",
        "disabled": true,
        "headers": {
          "x-ref-api-key": "{env:REF_API_KEY}",
        },
      },
      "chrome-devtools": {
        "type": "local",
        "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
        "disabled": true,
      },
    },
  },
}
