{
  "$schema": "https://opencode.ai/tui.json",
  "plugin": ["@sahiljassal/opencode-anthropic-auth"],
  "theme": "gruvbox",
  "keybinds": { "terminal_suspend": "none", "app_exit": "ctrl+c" },
  "attention": { "enabled": true, "sound": true, "volume": 0.8 },
  "scroll_acceleration": { "enabled": true },
}
