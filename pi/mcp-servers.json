{
  "mcpServers": {
    "exa": {
      "url": "https://mcp.exa.ai/mcp",
      "headers": { "Authorization": "Bearer ${EXA_API_KEY}" },
      "enabled": true
    },
    "ref": {
      "url": "https://api.ref.tools/mcp",
      "headers": { "x-ref-api-key": "${REF_API_KEY}" },
      "enabled": true
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"]
    }
  }
}
